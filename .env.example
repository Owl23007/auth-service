# Application
APP_NAME=auth
APP_WEBSITE=http://localhost
APP_ORG_NAME=ExampleOrg
APP_EMAIL=support@example.com
APP_PHONE=

# Server
SERVER_PORT=8081

# Datasource
DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_service
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Nacos
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=user@example.com
MAIL_PASSWORD=secret

# Aliyun
ALIYUN_OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_BUCKET_NAME=your-bucket-name
ALIYUN_ROLE_ARN=your-role-arn
ALIYUN_CDN_POINT=https://cdn.example.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
